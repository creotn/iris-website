# Copy to .env and fill in. Placeholders only — never commit real secrets.

API_URL=http://localhost:5000          # backend origin (server-only)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_URL=http://localhost:3000  # this site's public URL; the /download QR code points here
CACHE_REVALIDATE_SECRET=               # shared secret for POST /api/clear-cache

# Where /download sends phones. Optional, https only: when empty, the links in src/config/stores.ts are used.
# Inlined at build time (see the Dockerfile ARGs): changing them needs a rebuild.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/sa/app/iris/id6809477836
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.iflotech.iris
